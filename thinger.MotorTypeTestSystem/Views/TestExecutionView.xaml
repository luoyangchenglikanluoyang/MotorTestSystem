<UserControl
    x:Class="thinger.MotorTypeTestSystem.Views.TestExecutionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:thinger.MotorTypeTestSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="1020"
    d:DesignWidth="1980"
    Background="White"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  布尔值转可见性（控制右侧实时数据栏的隐藏/显示）  -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  左侧悬浮导航栏按钮样式：收起时只露图标，展开时显示文字  -->
        <Style x:Key="SubNavBtnStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <!--  利用 Tag 放图标，固定 40px 宽度居中，确保导航栏收起时只露图标、不露半截字  -->
                                <TextBlock
                                    Width="40"
                                    VerticalAlignment="Center"
                                    FontSize="16"
                                    Text="{TemplateBinding Tag}"
                                    TextAlignment="Center" />
                                <!--  导航文字  -->
                                <ContentPresenter Margin="4,0,12,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  右侧实时参数黑底仪表卡片样式  -->
        <Style x:Key="RealtimeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="3,4" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <!--  =========================================================================  -->
        <!--  第一部分：左侧区域（底层留空的主显示容器 + 顶层鼠标悬浮弹出的导航栏）  -->
        <!--  =========================================================================  -->

        <Grid Grid.Column="0">
            <!--  1. 主显示区域容器（目前完全留空，后续根据左侧导航切换具体页面）  -->
            <!--  Effect="{StaticResource EffectShadow2}"是去资源字典里找 EffectShadow2 的阴影效果，拿来给这个控件用。  -->
            <Border
                Margin="64,10,4,10"
                Background="White"
                CornerRadius="3"
                Effect="{StaticResource EffectShadow2}">
                <!--  预留的子页面切换容器  -->
                <ContentControl Content="{Binding CurrentSubView}" />
            </Border>

            <!--  2. 左侧悬浮导航栏（默认缩起 48px，鼠标放上去丝滑展开到 172px）  -->
            <!--  VerticalAlignment="Stretch"是在垂直方向上，把控件“拉伸”填满父容器给它的全部可用高度。  -->
            <Border
                Margin="5,10,0,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Panel.ZIndex="10"
                Background="White"
                ClipToBounds="True"
                CornerRadius="4"
                Effect="{StaticResource EffectShadow2}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="48" />
                        <Style.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            DecelerationRatio="0.8"
                                            Storyboard.TargetProperty="Width"
                                            To="172"
                                            Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            DecelerationRatio="0.8"
                                            Storyboard.TargetProperty="Width"
                                            To="48"
                                            Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Margin="0,10">
                    <!--  顶部菜单标识  -->
                    <StackPanel
                        Height="36"
                        Margin="4,0,0,8"
                        Orientation="Horizontal">
                        <TextBlock
                            Width="40"
                            VerticalAlignment="Center"
                            FontSize="17"
                            Foreground="#64748B"
                            Text="☰"
                            TextAlignment="Center" />
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#64748B"
                            Text="试验项目导航" />
                    </StackPanel>

                    <hc:Divider Margin="8,0,8,8" />

                    <!--  导航项：铭牌信息直接放在导航栏第一位  -->
                    <RadioButton
                        Command="{Binding SwitchSubViewCommand}"
                        CommandParameter="Nameplate"
                        Content="铭牌信息"
                        IsChecked="True"
                        Style="{StaticResource SubNavBtnStyle}"
                        Tag="📋" />
                    <RadioButton
                        Command="{Binding SwitchSubViewCommand}"
                        CommandParameter="DcResistance"
                        Content="直流电阻"
                        Style="{StaticResource SubNavBtnStyle}"
                        Tag="🔧" />
                    <RadioButton
                        Command="{Binding SwitchSubViewCommand}"
                        CommandParameter="Nameplate"
                        Content="绝缘电阻"
                        Style="{StaticResource SubNavBtnStyle}"
                        Tag="🛡️" />
                    <RadioButton
                        Command="{Binding SwitchSubViewCommand}"
                        CommandParameter="Nameplate"
                        Content="空载试验"
                        Style="{StaticResource SubNavBtnStyle}"
                        Tag="⚡" />
                    <RadioButton
                        Command="{Binding SwitchSubViewCommand}"
                        CommandParameter="Nameplate"
                        Content="堵转试验"
                        Style="{StaticResource SubNavBtnStyle}"
                        Tag="🔒" />
                    <RadioButton
                        Command="{Binding SwitchSubViewCommand}"
                        CommandParameter="Nameplate"
                        Content="温升试验"
                        Style="{StaticResource SubNavBtnStyle}"
                        Tag="🌡️" />
                    <RadioButton
                        Command="{Binding SwitchSubViewCommand}"
                        CommandParameter="Nameplate"
                        Content="负载试验"
                        Style="{StaticResource SubNavBtnStyle}"
                        Tag="📊" />
                </StackPanel>
            </Border>
        </Grid>


        <!--  =========================================================================  -->
        <!--  第二部分：右侧区域（点击按钮隐藏/展开 + 上下滚动的实时数据信息栏）  -->
        <!--  =========================================================================  -->

        <StackPanel
            Grid.Column="1"
            Margin="0,10,10,10"
            Orientation="Horizontal">
            <ToggleButton
                x:Name="RightPanelToggle"
                Width="28"
                Height="80"
                VerticalAlignment="Center"
                hc:BorderElement.CornerRadius="6,0,0,6"
                Background="White"
                BorderThickness="0"
                Cursor="Hand"
                Effect="{StaticResource EffectShadow2}"
                FontSize="14"
                IsChecked="True">
                <ToggleButton.Style>
                    <Style BasedOn="{StaticResource ToggleButtonBaseStyle}" TargetType="ToggleButton">
                        <Setter Property="Content" Value="▶" />
                        <Setter Property="Foreground" Value="#64748B" />
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Content" Value="◀" />
                                <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <!--  2. 右侧实时数据信息栏主体  -->
            <Border
                Width="450"
                Background="White"
                CornerRadius="8"
                Effect="{StaticResource EffectShadow2}"
                Visibility="{Binding IsChecked, ElementName=RightPanelToggle, Converter={StaticResource BoolToVis}}">

                <DockPanel>
                    <!--  顶部固定标题  -->
                    <Border
                        Padding="14,12"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0"
                        DockPanel.Dock="Top">
                        <DockPanel>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#1E293B"
                                Text="实时采集数据" />
                            <hc:Badge
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Status="Processing" />
                        </DockPanel>
                    </Border>

                    <!--  上下滑动的实时数据列表  -->
                    <ScrollViewer Padding="10,8" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <hc:Divider Margin="0,4,0,8" Content="三相电压 / 电流" />
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="18"
                                            Foreground="Yellow"
                                            Text="Uab 电压 (V)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="25"
                                            FontWeight="Bold"
                                            Foreground="Yellow"
                                            Text="0.00" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="18"
                                            Foreground="Yellow"
                                            Text="Ia 电流 (A)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="25"
                                            FontWeight="Bold"
                                            Foreground="Yellow"
                                            Text="0.00" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="18"
                                            Foreground="#4ADE80"
                                            Text="Ubc 电压 (V)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="25"
                                            FontWeight="Bold"
                                            Foreground="#4ADE80"
                                            Text="0.00" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="18"
                                            Foreground="#4ADE80"
                                            Text="Ib 电流 (A)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="25"
                                            FontWeight="Bold"
                                            Foreground="#4ADE80"
                                            Text="0.00" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#94A3B8"
                                            Text="Uca 电压 (V)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="19"
                                            FontWeight="Bold"
                                            Foreground="#38BDF8"
                                            Text="0.00" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#94A3B8"
                                            Text="Ic 电流 (A)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="19"
                                            FontWeight="Bold"
                                            Foreground="#4ADE80"
                                            Text="0.00" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#94A3B8"
                                            Text="平均电压 U (V)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="19"
                                            FontWeight="Bold"
                                            Foreground="#38BDF8"
                                            Text="0.00" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#94A3B8"
                                            Text="平均电流 I (A)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="19"
                                            FontWeight="Bold"
                                            Foreground="#4ADE80"
                                            Text="0.00" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <hc:Divider Margin="0,10,0,8" Content="功率与电网参数" />
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#94A3B8"
                                            Text="输入功率 P1 (kW)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="19"
                                            FontWeight="Bold"
                                            Foreground="#FACC15"
                                            Text="0.00" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#94A3B8"
                                            Text="输出功率 P2 (kW)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="19"
                                            FontWeight="Bold"
                                            Foreground="#FACC15"
                                            Text="0.00" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#94A3B8"
                                            Text="功率因数 cosφ" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="19"
                                            FontWeight="Bold"
                                            Foreground="#F8FAFC"
                                            Text="0.000" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#94A3B8"
                                            Text="频率 f (Hz)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="19"
                                            FontWeight="Bold"
                                            Foreground="#F8FAFC"
                                            Text="0.00" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <hc:Divider Margin="0,10,0,8" Content="机械与温度参数" />
                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#94A3B8"
                                            Text="实时转矩 T (N·m)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="19"
                                            FontWeight="Bold"
                                            Foreground="#F472B6"
                                            Text="0.00" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#94A3B8"
                                            Text="实时转速 n (r/m)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="19"
                                            FontWeight="Bold"
                                            Foreground="#A78BFA"
                                            Text="0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#94A3B8"
                                            Text="绕组温度 (℃)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="19"
                                            FontWeight="Bold"
                                            Foreground="#FB923C"
                                            Text="0.0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource RealtimeCardStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="#94A3B8"
                                            Text="环境温度 (℃)" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="19"
                                            FontWeight="Bold"
                                            Foreground="#FB923C"
                                            Text="0.0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
