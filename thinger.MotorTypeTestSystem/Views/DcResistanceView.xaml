<UserControl x:Class="thinger.MotorTypeTestSystem.Views.DcResistanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:thinger.MotorTypeTestSystem.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             Background="White"
             d:DesignHeight="850" d:DesignWidth="1100">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
            <StackPanel>
                <!-- ========================================================================= -->
                <!--  顶部：标题与操作栏卡片                                                    -->
                <!-- ========================================================================= -->
                <Border Background="White" CornerRadius="10" Padding="24,16" Margin="0,0,0,15" Effect="{StaticResource EffectShadow2}" >
                    <DockPanel>
                        <!-- 左侧：标题与电机编号 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="5" Height="22" Background="#475569" CornerRadius="2" Margin="0,0,12,0"/>
                            <TextBlock Text="🔧 电机冷态直流电阻试验" FontSize="25" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            <Border Background="#F1F5F9" CornerRadius="4" Padding="10,4" Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="当前试验编号：" VerticalAlignment="Center" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding DcRecord.RecordId, FallbackValue='未关联'}" VerticalAlignment="Center"  FontSize="12" FontWeight="Bold" Foreground="#334155"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 右侧：操作按钮 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <!-- 计算按钮 -->
                            <Button Content="⚡ 立即计算" 
                                Command="{Binding CalculateCommand}"
                                Height="38" Padding="20,0" Margin="0,0,12,0"
                                FontSize="14" FontWeight="Bold"
                                Background="#E2E8F0" Foreground="#1E293B" BorderThickness="0"
                                hc:BorderElement.CornerRadius="6" Cursor="Hand"/>

                            <!-- 保存按钮 -->
                            <Button Content="💾 保存试验数据" 
                                Command="{Binding SaveCommand}"
                                Height="38" Padding="24,0"
                                FontSize="14" FontWeight="Bold"
                                Style="{StaticResource ButtonPrimary}"
                                hc:BorderElement.CornerRadius="6" Cursor="Hand"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ========================================================================= -->
                <!--  主体区域：左侧输入区 + 右侧计算与判定结果卡片                              -->
                <!-- ========================================================================= -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <!-- 左侧输入 -->
                        <ColumnDefinition Width="20"/>
                        <!-- 间距 -->
                        <ColumnDefinition Width="1*"/>
                        <!-- 右侧计算结果 -->
                    </Grid.ColumnDefinitions>

                    <!--  左侧卡片：电阻参数录入（横线输入框）                                    -->
                    <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="24" Effect="{StaticResource EffectShadow2}">
                        <StackPanel>
                            <TextBlock Text="📋 试验测量数据录入" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,30"/>
                            <!-- 1. U-V 线电阻 -->
                            <TextBlock Text="U - V 线间电阻 (Ω)" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" 
                                         HorizontalContentAlignment="Center"
                                     Text="{Binding DcRecord.Ruv, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource UnderlineTextBoxStyle}"/>
                                <Button Grid.Column="2" Content="📥 采入 U-V" 
                                    Command="{Binding SampleResistanceCommand}" CommandParameter="UV"
                                    Style="{StaticResource SampleBtnStyle}"/>
                            </Grid>

                            <!-- 2. V-W 线电阻 -->
                            <TextBlock Text="V - W 线间电阻 (Ω)" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" 
                                         HorizontalContentAlignment="Center"
                                     Text="{Binding DcRecord.Rvw, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource UnderlineTextBoxStyle}"/>
                                <Button Grid.Column="2" Content="📥 采入 V-W" 
                                    Command="{Binding SampleResistanceCommand}" CommandParameter="VW"
                                    Style="{StaticResource SampleBtnStyle}"/>
                            </Grid>

                            <!-- 3. W-U 线电阻 -->
                            <TextBlock Text="W - U 线间电阻 (Ω)" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" 
                                         HorizontalContentAlignment="Center"
                                     Text="{Binding DcRecord.Rwu, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource UnderlineTextBoxStyle}"/>
                                <Button Grid.Column="2" Content="📥 采入 W-U" 
                                    Command="{Binding SampleResistanceCommand}" CommandParameter="WU"
                                    Style="{StaticResource SampleBtnStyle}"/>
                            </Grid>

                            <hc:Divider Margin="0,10,0,20"/>
                            <!-- 4. 温度与判定上限 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 环境/绕组温度 -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="测量时绕组/室温 (℃)" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBox 
                                        HorizontalContentAlignment="Center"
                                        Text="{Binding DcRecord.WindingTemp, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource UnderlineTextBoxStyle}"/>
                                </StackPanel>
                                <!-- 允许上限 -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="不平衡度允许上限 (%)" FontSize="13" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,6"/>
                                    <TextBox 
                                        HorizontalContentAlignment="Center"
                                        Text="{Binding DcRecord.MaxAllowedUnbalance, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource UnderlineTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  右侧卡片：计算结果与合格判定看板                           -->
                    <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="24" Effect="{StaticResource EffectShadow2}">
                        <StackPanel>
                            <TextBlock Text="📊 试验换算结果与判定"  FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,30"/>
                            <!-- 结果展示小卡片 1：三相平均线电阻 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                                <DockPanel>
                                    <TextBlock Text="三相平均电阻 R_avg" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DcRecord.AverageResistance, StringFormat={}{0:F5} Ω}" 
                                           HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                </DockPanel>
                            </Border>

                            <!-- 结果展示小卡片 2：三相电阻不平衡度 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                                <DockPanel>
                                    <TextBlock Text="三相电阻不平衡度 ΔR" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DcRecord.UnbalanceRate, StringFormat={}{0:F3} %}" 
                                           HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                </DockPanel>
                            </Border>
                            <!-- 结果展示小卡片 3：折算至 20℃ 基准电阻 -->
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="折算至 20℃ 电阻 R_20" FontSize="13" Foreground="#64748B"/>
                                        <TextBlock Text="(基准材质常数 K1 = 235)" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DcRecord.ResistanceAt20C, StringFormat={}{0:F5} Ω}" 
                                           HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                                </DockPanel>
                            </Border>

                            <!-- 结论判定徽章：绿色代表合格，红色代表不合格 -->
                            <Border CornerRadius="8" Padding="20,16" Margin="0,10,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <!-- 默认浅红 -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DcRecord.IsQualified}" Value="True">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                <!-- 浅绿 -->
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DcRecord.IsQualified}" Value="false">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                <!-- 浅绿 -->
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value=""/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DcRecord.IsQualified}" Value="True">
                                                        <Setter Property="Text" Value="判定结论：合格"/>
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DcRecord.IsQualified}" Value="false">
                                                        <Setter Property="Text" Value="判定结论：不合格"/>
                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="依据：三相电阻不平衡度 ≤ 允许上限" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
