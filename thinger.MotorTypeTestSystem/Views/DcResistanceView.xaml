<UserControl
    x:Class="thinger.MotorTypeTestSystem.Views.DcResistanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:thinger.MotorTypeTestSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="850"
    d:DesignWidth="1100"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="White"
    mc:Ignorable="d">
    <Grid>
        <ScrollViewer Padding="10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  =========================================================================  -->
                <!--  顶部：标题与操作栏卡片  -->
                <!--  =========================================================================  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="24,16"
                    Background="White"
                    CornerRadius="10"
                    Effect="{StaticResource EffectShadow2}">
                    <DockPanel>
                        <!--  左侧：标题与电机编号  -->
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Border
                                Width="5"
                                Height="22"
                                Margin="0,0,12,0"
                                Background="#475569"
                                CornerRadius="2" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="25"
                                FontWeight="Bold"
                                Foreground="#0F172A"
                                Text="🔧 电机冷态直流电阻试验" />
                            <Border
                                Margin="16,0,0,0"
                                Padding="10,4"
                                Background="#F1F5F9"
                                CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#64748B"
                                        Text="当前试验编号：" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="#334155"
                                        Text="{Binding DcRecord.RecordId, FallbackValue='未关联'}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!--  右侧：操作按钮  -->
                        <StackPanel
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right"
                            Orientation="Horizontal">
                            <!--  计算按钮  -->
                            <Button
                                Height="38"
                                Margin="0,0,12,0"
                                Padding="20,0"
                                hc:BorderElement.CornerRadius="6"
                                Background="#E2E8F0"
                                BorderThickness="0"
                                Command="{Binding CalculateCommand}"
                                Content="⚡ 立即计算"
                                Cursor="Hand"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#1E293B" />

                            <!--  保存按钮  -->
                            <Button
                                Height="38"
                                Padding="24,0"
                                hc:BorderElement.CornerRadius="6"
                                Command="{Binding SaveCommand}"
                                Content="💾 保存试验数据"
                                Cursor="Hand"
                                FontSize="14"
                                FontWeight="Bold"
                                Style="{StaticResource ButtonPrimary}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!--  =========================================================================  -->
                <!--  主体区域：左侧输入区 + 右侧计算与判定结果卡片  -->
                <!--  =========================================================================  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <!--  左侧输入  -->
                        <ColumnDefinition Width="20" />
                        <!--  间距  -->
                        <ColumnDefinition Width="1*" />
                        <!--  右侧计算结果  -->
                    </Grid.ColumnDefinitions>

                    <!--  左侧卡片：电阻参数录入（横线输入框）  -->
                    <Border
                        Grid.Column="0"
                        Padding="24"
                        Background="White"
                        CornerRadius="10"
                        Effect="{StaticResource EffectShadow2}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,30"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#0F172A"
                                Text="📋 试验测量数据录入" />
                            <!--  1. U-V 线电阻  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#475569"
                                Text="U - V 线间电阻 (Ω)" />
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource UnderlineTextBoxStyle}"
                                    Text="{Binding DcRecord.Ruv, UpdateSourceTrigger=LostFocus, TargetNullValue=0}" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding SampleResistanceCommand}"
                                    CommandParameter="UV"
                                    Content="📥 采入 U-V"
                                    Style="{StaticResource SampleBtnStyle}" />
                            </Grid>

                            <!--  2. V-W 线电阻  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#475569"
                                Text="V - W 线间电阻 (Ω)" />
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource UnderlineTextBoxStyle}"
                                    Text="{Binding DcRecord.Rvw, UpdateSourceTrigger=LostFocus, TargetNullValue=0}" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding SampleResistanceCommand}"
                                    CommandParameter="VW"
                                    Content="📥 采入 V-W"
                                    Style="{StaticResource SampleBtnStyle}" />
                            </Grid>

                            <!--  3. W-U 线电阻  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#475569"
                                Text="W - U 线间电阻 (Ω)" />
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Grid.Column="0"
                                    HorizontalContentAlignment="Center"
                                    Style="{StaticResource UnderlineTextBoxStyle}"
                                    Text="{Binding DcRecord.Rwu, UpdateSourceTrigger=LostFocus, TargetNullValue=0}" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding SampleResistanceCommand}"
                                    CommandParameter="WU"
                                    Content="📥 采入 W-U"
                                    Style="{StaticResource SampleBtnStyle}" />
                            </Grid>

                            <hc:Divider Margin="0,10,0,20" />
                            <!--  4. 温度与判定上限  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!--  环境/绕组温度  -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#475569"
                                        Text="测量时绕组/室温 (℃)" />
                                    <TextBox
                                        HorizontalContentAlignment="Center"
                                        Style="{StaticResource UnderlineTextBoxStyle}"
                                        Text="{Binding DcRecord.WindingTemp, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <!--  允许上限  -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="#475569"
                                        Text="不平衡度允许上限 (%)" />
                                    <TextBox
                                        HorizontalContentAlignment="Center"
                                        Style="{StaticResource UnderlineTextBoxStyle}"
                                        Text="{Binding DcRecord.MaxAllowedUnbalance, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!--  右侧卡片：计算结果与合格判定看板  -->
                    <Border
                        Grid.Column="2"
                        Padding="24"
                        Background="White"
                        CornerRadius="10"
                        Effect="{StaticResource EffectShadow2}">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,30"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#0F172A"
                                Text="📊 试验换算结果与判定" />
                            <!--  结果展示小卡片 1：三相平均线电阻  -->
                            <Border
                                Margin="0,0,0,12"
                                Padding="16,12"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8">
                                <DockPanel>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="#64748B"
                                        Text="三相平均电阻 R_avg" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="#0F172A"
                                        Text="{Binding DcRecord.AverageResistance, StringFormat={}{0:F5} Ω}" />
                                </DockPanel>
                            </Border>

                            <!--  结果展示小卡片 2：三相电阻不平衡度  -->
                            <Border
                                Margin="0,0,0,12"
                                Padding="16,12"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8">
                                <DockPanel>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Foreground="#64748B"
                                        Text="三相电阻不平衡度 ΔR" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="#0F172A"
                                        Text="{Binding DcRecord.UnbalanceRate, StringFormat={}{0:F3} %}" />
                                </DockPanel>
                            </Border>
                            <!--  结果展示小卡片 3：折算至 20℃ 基准电阻  -->
                            <Border
                                Margin="0,0,0,16"
                                Padding="16,12"
                                Background="#F8FAFC"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="8">
                                <DockPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="#64748B"
                                            Text="折算至 20℃ 电阻 R_20" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="10"
                                            Foreground="#94A3B8"
                                            Text="(基准材质常数 K1 = 235)" />
                                    </StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="#0F172A"
                                        Text="{Binding DcRecord.ResistanceAt20C, StringFormat={}{0:F5} Ω}" />
                                </DockPanel>
                            </Border>

                            <!--  结论判定徽章：绿色代表合格，红色代表不合格  -->
                            <Border
                                Margin="0,10,0,0"
                                Padding="20,16"
                                CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White" />
                                        <!--  默认浅红  -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DcRecord.IsQualified}" Value="True">
                                                <Setter Property="Background" Value="#DCFCE7" />
                                                <!--  浅绿  -->
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DcRecord.IsQualified}" Value="false">
                                                <Setter Property="Background" Value="#FEE2E2" />
                                                <!--  浅绿  -->
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        HorizontalAlignment="Center"
                                        FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DcRecord.IsQualified}" Value="True">
                                                        <Setter Property="Text" Value="判定结论：合格" />
                                                        <Setter Property="Foreground" Value="#166534" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DcRecord.IsQualified}" Value="false">
                                                        <Setter Property="Text" Value="判定结论：不合格" />
                                                        <Setter Property="Foreground" Value="#991B1B" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Foreground="#64748B"
                                        Text="依据：三相电阻不平衡度 ≤ 允许上限" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
