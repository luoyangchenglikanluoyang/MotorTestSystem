<UserControl
    x:Class="thinger.MotorTypeTestSystem.Views.HistoryQueryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:thinger.MotorTypeTestSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="White"
    mc:Ignorable="d">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!--  顶部搜索过滤栏  -->
            <RowDefinition Height="*" />
            <!--  核心历史数据表格  -->
        </Grid.RowDefinitions>

        <!--  顶部：搜索与过滤操作卡片  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="10,16"
            Background="White"
            CornerRadius="10"
            Effect="{StaticResource EffectShadow2}">
            <DockPanel>
                <!--  左侧：标题与统计徽章  -->
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Width="5"
                        Height="22"
                        Margin="0,0,12,0"
                        Background="#1E293B"
                        CornerRadius="2" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#0F172A"
                        Text="📁 电机型式试验历史档案" />
                </StackPanel>
                <!--  右侧：搜索输入框与按钮  -->
                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <!--  搜索输入框  -->
                    <TextBox
                        Width="260"
                        Height="36"
                        Margin="0,0,12,0"
                        VerticalContentAlignment="Center"
                        hc:BorderElement.CornerRadius="6"
                        hc:InfoElement.Placeholder="输入电机条码 / 出厂编号 / 型号..."
                        FontSize="13"
                        Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" />
                    <!--  查询按钮  -->
                    <Button
                        Height="36"
                        Margin="0,0,8,0"
                        Padding="18,0"
                        hc:BorderElement.CornerRadius="6"
                        Command="{Binding QueryCommand}"
                        Content="🔍 查询"
                        Cursor="Hand"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Style="{StaticResource ButtonPrimary}" />
                    <!--  重置按钮  -->
                    <Button
                        Height="36"
                        Padding="16,0"
                        hc:BorderElement.CornerRadius="6"
                        Command="{Binding ResetCommand}"
                        Content="🔄 刷新/重置"
                        Cursor="Hand"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Style="{StaticResource ButtonDefault}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  主体：历史数据列表卡片  -->
        <Border
            Grid.Row="1"
            Padding="16"
            Background="White"
            CornerRadius="10"
            Effect="{StaticResource EffectShadow2}">
            <DataGrid
                hc:DataGridAttach.ShowRowNumber="True"
                AutoGenerateColumns="False"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserResizeRows="False"
                FontSize="13"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                HorizontalGridLinesBrush="#F1F5F9"
                IsReadOnly="True"
                ItemsSource="{Binding Records}"
                RowHeight="48"
                SelectedItem="{Binding SelectedRecord}"
                Style="{StaticResource DataGridBaseStyle}">

                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A" />
                </DataGrid.Resources>
                <!--  每一行的样式：支持鼠标双击直达试验台  -->
                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource DataGridRowStyle}" TargetType="DataGridRow">
                        <EventSetter Event="MouseDoubleClick" Handler="DataGridRow_MouseDoubleClick" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                            <!--  核心：当这一行被选中时，强制背景变为质感浅灰  -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CellStyle>
                    <Style BasedOn="{StaticResource DataGridCellStyle}" TargetType="DataGridCell">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E2E8F0" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <!--  1. 出厂条码/序列号（核心标识，加粗纯黑）  -->
                    <DataGridTemplateColumn Width="1.5*" Header="电机出厂条码 (SN)">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,0" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="#0F172A"
                                        Text="{Binding MotorSerialNumber}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="#94A3B8"
                                        Text="{Binding Id}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!--  2. 电机型号  -->
                    <DataGridTextColumn
                        Width="1.2*"
                        Binding="{Binding MotorModel}"
                        FontWeight="SemiBold"
                        Foreground="#334155"
                        Header="电机型号" />
                    <!--  3. 额定参数 (功率/电压/电流)  -->
                    <DataGridTemplateColumn Width="1.5*" Header="额定参数规格">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Border
                                        Margin="0,0,6,0"
                                        Padding="6,2"
                                        Background="#F1F5F9"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#475569"
                                            Text="{Binding RatedPower, StringFormat={}{0} kW}" />
                                    </Border>
                                    <Border
                                        Margin="0,0,6,0"
                                        Padding="6,2"
                                        Background="#F1F5F9"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#475569"
                                            Text="{Binding RatedVoltage, StringFormat={}{0} V}" />
                                    </Border>
                                    <Border
                                        Padding="6,2"
                                        Background="#F1F5F9"
                                        CornerRadius="4">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#475569"
                                            Text="{Binding RatedCurrent, StringFormat={}{0} A}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!--  4. 试验建档时间  -->
                    <DataGridTextColumn
                        Width="1.4*"
                        Binding="{Binding TestTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                        Foreground="#64748B"
                        Header="试验建档时间" />
                    <!--  5. 状态标签  -->
                    <DataGridTemplateColumn Width="100" Header="当前状态">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8,3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#EFF6FF"
                                    CornerRadius="4">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="#2563EB"
                                        Text="试验中" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!--  6. 操作列（一键载入现场 / 删除）  -->
                    <DataGridTemplateColumn Width="180" Header="操作">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <!--  进入试验按钮  -->
                                    <Button
                                        Height="30"
                                        Margin="0,0,8,0"
                                        Padding="10,0"
                                        hc:BorderElement.CornerRadius="4"
                                        Command="{Binding DataContext.OpenExecutionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="⚡ 进入试验"
                                        Cursor="Hand"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Style="{StaticResource ButtonPrimary}" />
                                    <!--  删除记录按钮  -->
                                    <Button
                                        Width="32"
                                        Height="30"
                                        Padding="0"
                                        hc:BorderElement.CornerRadius="4"
                                        Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Content="🗑️"
                                        Cursor="Hand"
                                        Style="{StaticResource ButtonDanger}"
                                        ToolTip="删除此条测试记录" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
