<UserControl
    x:Class="thinger.MotorTypeTestSystem.Views.TemperatureRiseView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:thinger.MotorTypeTestSystem.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    d:DesignHeight="850"
    d:DesignWidth="1100"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="White"
    mc:Ignorable="d">
    <Grid>
        <ScrollViewer Padding="10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  =========================================================================  -->
                <!--  顶部：标题与操作栏卡片  -->
                <!--  =========================================================================  -->
                <Border
                    Margin="0,0,0,15"
                    Padding="24,16"
                    Background="White"
                    CornerRadius="10"
                    Effect="{StaticResource EffectShadow2}">
                    <DockPanel>
                        <!--  左侧：标题与电机编号  -->
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Border
                                Width="5"
                                Height="22"
                                Margin="0,0,12,0"
                                Background="#EA580C"
                                CornerRadius="2" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="25"
                                FontWeight="Bold"
                                Foreground="#0F172A"
                                Text="🌡️ 电机温升试验" />
                            <Border
                                Margin="16,0,0,0"
                                Padding="10,4"
                                Background="#F1F5F9"
                                CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#64748B"
                                        Text="当前试验编号：" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="#334155"
                                        Text="{Binding MotorRecord.Id, FallbackValue='未关联'}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!--  右侧：操作按钮组  -->
                        <!-- 右侧：试验控制按钮组与实时状态指示 -->
                        <StackPanel HorizontalAlignment="Right" DockPanel.Dock="Right" Orientation="Horizontal">

                            <!-- 1. 试验运行时间胶囊 -->
                            <Border Margin="0,0,12,0" Padding="12,6" Background="#F1F5F9" CornerRadius="6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏱ 试验时长：" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ElapsedTimeString, FallbackValue='00:00:00'}" 
                       FontSize="13" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <!-- 2. 国标热稳定状态胶囊 -->
                            <Border Margin="0,0,12,0" Padding="12,6" Background="#FEF3C7" CornerRadius="6" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔥 热稳定判定：" FontSize="12" Foreground="#D97706" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ThermalStatusText, FallbackValue='未开始'}" 
                       FontSize="13" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <!-- 3. 通道设置按钮 -->
                            <Button Height="38" Margin="0,0,8,0" Padding="14,0" hc:BorderElement.CornerRadius="6"
            Background="#F1F5F9" BorderThickness="1" BorderBrush="#CBD5E1"
            Command="{Binding OpenChannelConfigCommand}" Content="⚙ 测点配置"
            Cursor="Hand" FontSize="13" FontWeight="SemiBold" Foreground="#334155" />
                            <!-- 4. 开始试验按钮 -->
                            <Button Height="38" Margin="0,0,8,0" Padding="18,0" hc:BorderElement.CornerRadius="6"
            Command="{Binding StartTestCommand}" Content="▶ 开始试验"
            Cursor="Hand" FontSize="13" FontWeight="Bold" Style="{StaticResource ButtonPrimary}" />
                            <!-- 5. 停止试验按钮 -->
                            <Button Height="38" Padding="16,0" hc:BorderElement.CornerRadius="6"
            Command="{Binding StopTestCommand}" Content="⏹ 停止试验"
            Cursor="Hand" FontSize="13" FontWeight="Bold" Background="#DC2626" Foreground="White" BorderThickness="0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!--  =========================================================================  -->
                <!--  主体区域：预留折线图与状态监控区  -->
                <!--  =========================================================================  -->
                <Border
                    MinHeight="500"
                    Padding="24"
                    Background="White"
                    CornerRadius="10"
                    Effect="{StaticResource EffectShadow2}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#64748B"
                            Text="📈 温升曲线与监控工作区" />
                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="#94A3B8"
                            Text="点击右上角【⚙ 测点通道设置】即可随时配置巡检仪测点名称与通道启用状态" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
