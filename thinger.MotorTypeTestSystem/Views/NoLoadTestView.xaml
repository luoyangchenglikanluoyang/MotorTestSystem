<UserControl x:Class="thinger.MotorTypeTestSystem.Views.NoLoadTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:thinger.MotorTypeTestSystem.Views"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="White"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             FontFamily="Microsoft YaHei UI"
             mc:Ignorable="d" 
             d:DesignHeight="1100" d:DesignWidth="1450">
    <UserControl.Resources>
        <Style x:Key="CenterTextBlock" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BoldCenterTextBlock" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>
        <Style x:Key="BlueBoldTextBlock" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#2563EB" />
        </Style>
        <Style x:Key="OrangeBoldTextBlock" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#EA580C" />
        </Style>
        <Style x:Key="UnderlineInputStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <hc:ScrollViewer Padding="10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  =========================================================================  -->
                <!--  顶部：标题与操作栏卡片  -->
                <!--  =========================================================================  -->
                <Border Margin="0,0,0,15"
                        Padding="24,16"
                        Background="White"
                        CornerRadius="10"
                        Effect="{StaticResource EffectShadow2}">
                    <DockPanel>
                        <!-- 左侧：标题、流水号、铭牌额定参数 -->
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Border
                                Width="5"
                                Height="22"
                                Margin="0,0,12,0"
                                Background="#2563EB"
                                CornerRadius="2" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="22"
                                FontWeight="Bold"
                                Foreground="#0F172A"
                                Text="电机空载型式试验" />
                            <!-- 试验编号 -->
                            <Border
                                Margin="14,0,0,0"
                                Padding="10,4"
                                Background="#F1F5F9"
                                CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="12" Foreground="#64748B" Text="编号：" VerticalAlignment="Center" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Bold"
                                        VerticalAlignment="Center"
                                        Foreground="#334155"
                                        Text="{Binding MotorRecord.Id, FallbackValue='未关联'}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </hc:ScrollViewer>
    </Grid>
</UserControl>
