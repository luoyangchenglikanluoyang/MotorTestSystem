<UserControl
    x:Class="thinger.MotorTypeTestSystem.Controls.IndustrialTrendChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:thinger.MotorTypeTestSystem.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:thinger.MotorTypeTestSystem.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    d:DesignHeight="850"
    d:DesignWidth="800"
    Background="White"
    mc:Ignorable="d">
    <Border
        Padding="18,14"
        Background="White"
        CornerRadius="10"
        Effect="{StaticResource EffectShadow2}">
        <Grid>
            <Grid.RowDefinitions>
                <!--  顶部快捷工具栏  -->
                <RowDefinition Height="Auto" />
                <!--  ScottPlot 绘图主画布  -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  顶部工具栏  -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock
                        x:Name="TxtTitle"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#0F172A"
                        Text="📈 实时多通道曲线" />
                </StackPanel>

                <!--  右侧快捷操作按钮  -->
                <StackPanel
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Height="30"
                        Margin="0,0,6,0"
                        Padding="12,0"
                        hc:BorderElement.CornerRadius="4"
                        Background="#F1F5F9"
                        BorderThickness="0"
                        Click="BtnAutoScale_Click"
                        Content="🔍 自适应"
                        Cursor="Hand"
                        FontSize="12"
                        Foreground="#334155" />
                    <Button
                        Height="30"
                        Margin="0,0,6,0"
                        Padding="12,0"
                        hc:BorderElement.CornerRadius="4"
                        Background="#F1F5F9"
                        BorderThickness="0"
                        Click="BtnSaveImage_Click"
                        Content="📷 导出截图"
                        Cursor="Hand"
                        FontSize="12"
                        Foreground="#334155" />
                    <Button
                        Height="30"
                        Margin="0,0,6,0"
                        Padding="12,0"
                        hc:BorderElement.CornerRadius="4"
                        Background="#F1F5F9"
                        BorderThickness="0"
                        Click="BtnExportCsv_Click"
                        Content="📊 导出CSV"
                        Cursor="Hand"
                        FontSize="12"
                        Foreground="#334155" />
                    <Button
                        Height="30"
                        Padding="12,0"
                        hc:BorderElement.CornerRadius="4"
                        Background="#F1F5F9"
                        BorderThickness="0"
                        Click="BtnClear_Click"
                        Content="🗑️ 清空曲线"
                        Cursor="Hand"
                        FontSize="12"
                        Foreground="#EF4444" />
                </StackPanel>
            </DockPanel>
            <!--  2. ScottPlot 画布及交互覆盖层  -->
            <!--  2. ScottPlot 画布及交互覆盖层  -->
            <Grid Grid.Row="1">
                <!--  ScottPlot 绘图主画布  -->
                <sp:WpfPlot
                    x:Name="MainPlot"
                    MinHeight="420"
                    MouseLeave="MainPlot_MouseLeave"
                    MouseMove="MainPlot_MouseMove" />

                <!--  🌟 右上角交互式图例面板 (带 CheckBox 过滤，边距内收不跨轴)  -->
                <Border
                    Margin="0,15,30,0"
                    Padding="8,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#D9F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Effect="{StaticResource EffectShadow1}">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LegendItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Margin="2,2"
                                        VerticalContentAlignment="Center"
                                        Click="OnChannelVisibilityChanged"
                                        IsChecked="{Binding IsVisible, Mode=TwoWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse
                                                Width="9"
                                                Height="9"
                                                Margin="0,0,6,0"
                                                Fill="{Binding ColorBrush}" />
                                            <TextBlock
                                                FontSize="11.5"
                                                Foreground="#334155"
                                                Text="{Binding ChannelName}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!--  🌟 鼠标悬浮多通道实时探针卡片 (Tooltip: 雅灰半透明、内收避开Y轴刻度)  -->
                <Border
                    x:Name="HoverTooltipBorder"
                    Margin="80,15,0,0"
                    Padding="11,8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#C8334155"
                    BorderBrush="#64748B"
                    BorderThickness="1"
                    CornerRadius="6"
                    Effect="{StaticResource EffectShadow1}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock
                            x:Name="TxtTooltipTime"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="#38BDF8"
                            Text="⏱️ 时间: 00:00:00" />
                        <Separator Margin="0,4" Background="#475569" />
                        <ItemsControl x:Name="TooltipItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2" Orientation="Horizontal">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            Margin="0,0,6,0"
                                            Fill="{Binding ColorBrush}" />
                                        <TextBlock
                                            Width="90"
                                            FontSize="11"
                                            Foreground="#E2E8F0"
                                            Text="{Binding ChannelName}" />
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#FFFFFF"
                                            Text="{Binding ValueText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
