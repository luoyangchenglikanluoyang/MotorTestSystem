<UserControl x:Class="thinger.MotorTypeTestSystem.Controls.IndustrialTrendChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:local="clr-namespace:thinger.MotorTypeTestSystem.Controls"
             Background="White"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="White" CornerRadius="10" Padding="18,14" Effect="{StaticResource EffectShadow2}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 顶部快捷工具栏 -->
                <RowDefinition Height="Auto" />
                <!-- ScottPlot 绘图主画布 -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            
            <!--顶部工具栏-->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="📈 实时多通道曲线" 
                               FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 右侧快捷操作按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Height="30" Padding="12,0" Margin="0,0,6,0" hc:BorderElement.CornerRadius="4"
                            Background="#F1F5F9" BorderThickness="0" Cursor="Hand"
                            Click="BtnAutoScale_Click" Content="🔍 视野自适应" FontSize="12" Foreground="#334155"/>
                    <Button Height="30" Padding="12,0" Margin="0,0,6,0" hc:BorderElement.CornerRadius="4"
                            Background="#F1F5F9" BorderThickness="0" Cursor="Hand"
                            Click="BtnSaveImage_Click" Content="📷 导出截图" FontSize="12" Foreground="#334155" />
                    <Button Height="30" Padding="12,0" hc:BorderElement.CornerRadius="4"
                            Background="#F1F5F9" BorderThickness="0" Cursor="Hand"
                            Click="BtnClear_Click" Content="🗑️ 清空曲线" FontSize="12" Foreground="#EF4444" />
                </StackPanel>
            </DockPanel>
            <!-- 2. ScottPlot 画布 -->
            <sp:WpfPlot x:Name="MainPlot" Grid.Row="1" MinHeight="420" />
        </Grid>
    </Border>
</UserControl>
